#!/bin/sh

set -eu

PAYLOAD=/usr/local/libexec/annals/annals
SYSTEM_CONFIG='/Library/Application Support/Annals/config.toml'

target_selected=0
if [ -n "${ANNALS_CONFIG:-}" ] || [ -n "${ANNALS_LIBRARY:-}" ]; then
    target_selected=1
fi
for argument in "$@"; do
    case "$argument" in
        --config|--config=*|--library|--library=*)
            target_selected=1
            ;;
    esac
done

if [ "$target_selected" -eq 0 ]; then
    ANNALS_CONFIG=$SYSTEM_CONFIG
    export ANNALS_CONFIG
fi

exec "$PAYLOAD" "$@"
