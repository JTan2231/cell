schema_version = 1
key = "decisions/daily-email"
release_id = "__RELEASE_ID__"
release_root = "__RELEASE_ROOT__"
authority = "current-user-background"
overlap = "skip"
arguments = []
cwd = "__DECISIONS_STATE__"

[schedule]
kind = "local-calendar"
hour = 9
minute = 0
run_at_load = false

[launch]
kind = "interpreted"
interpreter = "/bin/sh"
interpreter_sha256 = "__INTERPRETER_SHA256__"
script = "__RELEASE_ROOT__/bin/decisions-daily-email"
script_sha256 = "__RUNNER_SHA256__"

[environment]
HOME = "__DECISIONS_HOME__"

[output]
stdout = "__DECISIONS_LOGS__/daily-email.stdout.log"
stderr = "__DECISIONS_LOGS__/daily-email.stderr.log"
