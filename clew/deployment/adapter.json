{
  "schema": 1,
  "product": "clew",
  "application": "Clew",
  "dependencies": ["cast", "email", "clockwork"],
  "runtime_versions": {
    "cast": {"minimum": "0.4.4", "before": "0.5.0"},
    "email": {"minimum": "0.6.0", "before": "0.7.0"},
    "clockwork": {"minimum": "0.6.0", "before": "0.7.0"}
  },
  "runtime_contracts": {
    "cast": {"cast.discovery.explore": {"minimum": 2, "before": 4}},
    "email": {"email.message.send": {"minimum": 4, "before": 5}},
    "clockwork": {"clockwork.schedule.operate": {"minimum": 5, "before": 6}}
  },
  "activation_bindings": ["clew/daily-email"],
  "description": "Install Clew under email admission maintenance, preserve application history, and restore the daily email schedule intent.",
  "adapter_binary": "clew-install"
}
