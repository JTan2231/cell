#!/bin/zsh

unsetopt VERBOSE XTRACE
# The native scheduled runner supplies its exact sibling payload. Capture the
# argument before user shell setup; do not follow the mutable public selector.
readonly todo_payload="$1"
source "$HOME/.zshrc" >/dev/null 2>&1
unsetopt VERBOSE XTRACE

print -rn -- "${RESEND_API_KEY-}" | /usr/bin/env -i \
    HOME="$HOME" \
    PATH=/usr/bin:/bin:/usr/sbin:/sbin \
    TODO_CONFIG="$HOME/Library/Application Support/Todo/config.toml" \
    /bin/zsh -c '
IFS= read -r RESEND_API_KEY
export RESEND_API_KEY
exec "$1" email send --scheduled
' todo-email "$todo_payload"
