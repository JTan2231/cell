{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parent_id", "text", "support_unit_ids"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^n(0|[1-9][0-9]*)$"
          },
          "parent_id": {
            "type": ["string", "null"],
            "pattern": "^n(0|[1-9][0-9]*)$"
          },
          "text": {
            "type": "string"
          },
          "support_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^u[0-9]{6,}$"
            }
          }
        }
      }
    }
  }
}
